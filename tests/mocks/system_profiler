#!/bin/bash
# 模拟 system_profiler SPUSBDataType：状态来自 MOCK_STATE 或 MOCK_STATE_FILE；
# MOCK_DFU_AFTER=n 表示计数达到 n 后转为 DFU（模拟引导过程中进入 DFU）
state="${MOCK_STATE:-}"
if [[ -f "${MOCK_STATE_FILE:-/tmp/dfu_guide_mock_state}" ]]; then
    state=$(cat "${MOCK_STATE_FILE:-/tmp/dfu_guide_mock_state}")
fi
if [[ -n "${MOCK_DFU_AFTER:-}" ]]; then
    n=$(cat "${MOCK_COUNTER_FILE:-/tmp/dfu_guide_mock_counter}" 2>/dev/null || echo 0)
    if (( n >= MOCK_DFU_AFTER )); then
        state="DFU"
    fi
fi
case "$state" in
    DFU)      echo "          Product ID: 0x1227" ;;
    Recovery) echo "          Product ID: 0x1281" ;;
    Normal)   echo "          Product ID: 0x12a8" ;;
esac
echo "          Vendor ID: 0x05ac"
