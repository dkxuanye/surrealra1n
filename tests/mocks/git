#!/bin/bash
# 模拟 git：config --global --get-all 返回 MOCK_GIT_INSTEADOF；其余记录日志
if [[ "$1" == "config" && "$2" == "--global" && "$3" == "--get-all" ]]; then
    if [[ -n "${MOCK_GIT_INSTEADOF:-}" ]]; then
        echo "$MOCK_GIT_INSTEADOF"
        exit 0
    fi
    exit 1
fi
echo "git $*" >> "${MOCK_GIT_LOG:-/tmp/setup_cn_git_log}"
exit 0
