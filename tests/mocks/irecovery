#!/bin/bash
# 模拟 irecovery：-q 查询；-n 重启（写入 MOCK_STATE_FILE 并递增 MOCK_COUNTER_FILE）
if [[ "$1" == "-q" ]]; then
    case "${MOCK_STATE:-}" in
        DFU)      echo "CPID: ${MOCK_CPID:-0x8030}"
                  echo "PRODUCT: ${MOCK_PRODUCT:-iPhone12,8}"
                  echo "MODE: DFU" ;;
        Recovery) echo "CPID: ${MOCK_CPID:-0x8030}"
                  echo "PRODUCT: ${MOCK_PRODUCT:-iPhone12,8}"
                  echo "MODE: Recovery" ;;
        *)        exit 1 ;;
    esac
elif [[ "$1" == "-n" ]]; then
    echo "Recovery" > "${MOCK_STATE_FILE:-/tmp/dfu_guide_mock_state}"
    n=$(cat "${MOCK_COUNTER_FILE:-/tmp/dfu_guide_mock_counter}" 2>/dev/null || echo 0)
    echo "$((n + 1))" > "${MOCK_COUNTER_FILE:-/tmp/dfu_guide_mock_counter}"
fi
exit 0
